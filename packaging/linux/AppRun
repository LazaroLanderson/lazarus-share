#!/bin/sh
set -eu
HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
export LD_LIBRARY_PATH="$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="$HERE/usr/plugins"
export GST_PLUGIN_SYSTEM_PATH_1_0=""
export GST_PLUGIN_PATH_1_0="$HERE/usr/lib/gstreamer-1.0"
export GST_PLUGIN_SCANNER_1_0="$HERE/usr/libexec/gst-plugin-scanner"
export PIPEWIRE_MODULE_DIR="$HERE/usr/lib/pipewire-0.3"
export SPA_PLUGIN_DIR="$HERE/usr/lib/spa-0.2"
export GST_REGISTRY_1_0="${XDG_CACHE_HOME:-$HOME/.cache}/lazarus-share/gstreamer-registry.bin"
mkdir -p "$(dirname -- "$GST_REGISTRY_1_0")"
export GST_DEBUG=0
exec "$HERE/usr/bin/lazarus-share" "$@"
