# Two public IPs assigned directly to this Linux server, or deploy TURN separately.
SIGNAL_IP=203.0.113.10
SIGNAL_HOST=salas.example.org
TURN_IP=203.0.113.11
TURN_HOST=turn.example.org
# Generate a private random value: python3 -c "import secrets; print(secrets.token_hex(32))"
# Only the signaling service and Coturn receive this value, never clients.
TURN_SECRET=REPLACE_WITH_RANDOM_SECRET
